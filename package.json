{
  "name": "trialinfo-homepage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "(주)트라이얼정보통신 공식 홈페이지 — 정적 사이트 (Eleventy)",
  "scripts": {
    "start": "eleventy --serve --incremental",
    "dev": "eleventy --serve --incremental",
    "build": "eleventy && npm run check:links",
    "build:only": "eleventy",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('_site',{recursive:true,force:true}))\"",
    "check:links": "node tools/check-links.mjs",
    "draft:post": "node tools/draft-post.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "svgo": "^4.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED"
}
