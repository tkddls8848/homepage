{#
  메인 슬라이드.
  기존 js/slider.js 는 left 값을 픽셀로 계산해 track 을 밀었습니다(창 크기가
  바뀌면 어긋나고, 터치 스와이프도 불가). 여기서는 브라우저의 scroll-snap 이
  위치를 담당하고 JS 는 "다음으로 가라"만 지시합니다.
#}
<section class="hero" data-hero aria-roledescription="캐러셀" aria-label="주요 소개">
  <div class="hero__track" data-hero-track tabindex="0" aria-live="off">
    {%- for slide in hero %}
    <div class="hero__slide" data-hero-slide data-active="{{ 'true' if loop.first else 'false' }}"
         role="group" aria-roledescription="슬라이드"
         aria-label="{{ loop.index }} / {{ hero.length }}">
      {%- if slide.image %}
      <div class="hero__media">
        <img src="{{ slide.image | url }}" alt="{{ slide.alt }}"
             {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
             decoding="async">
      </div>
      {%- endif %}
      <div class="container">
        <h2 class="hero__title">
          {%- for line in slide.title %}
          <span>{{ line }}</span>
          {%- endfor %}
        </h2>
        {%- if slide.text %}
        <p class="hero__text">{{ slide.text }}</p>
        {%- else %}
        <p class="hero__text">{{ site.description }}</p>
        {%- endif %}
        <div class="hero__actions">
          <a class="btn btn--primary" href="{{ '/products/' | url }}">제품 살펴보기</a>
          <a class="btn btn--ghost" href="{{ '/contact/inquiry/' | url }}">문의하기</a>
        </div>
      </div>
    </div>
    {%- endfor %}
  </div>

  <div class="container hero__controls" data-hero-controls>
    <div class="hero__dots" role="group" aria-label="슬라이드 선택">
      {%- for slide in hero %}
      <button class="hero__dot" type="button" data-hero-dot
              aria-current="{{ 'true' if loop.first else 'false' }}">
        <span class="sr-only">{{ loop.index }}번 슬라이드: {{ slide.title | join(" ") }}</span>
      </button>
      {%- endfor %}
    </div>
    <div class="hero__arrows">
      <button class="hero__arrow" type="button" data-hero-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 4.6 8 12l7.4 7.4 1.4-1.4L10.8 12l6-6z"/></svg>
        <span class="sr-only">이전 슬라이드</span>
      </button>
      <button class="hero__arrow" type="button" data-hero-next>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 4.6 7.2 6l6 6-6 6 1.4 1.4L16 12z"/></svg>
        <span class="sr-only">다음 슬라이드</span>
      </button>
    </div>
  </div>
</section>
