{#
  전역 헤더.
  - 기존 사이트: 페이지마다 같은 마크업 복사 + jQuery 로 클래스 토글
  - 지금:        include 한 곳 + 27줄짜리 vanilla JS (js/nav.js)
  헤더가 히어로 위에 겹쳐지는 페이지는 front matter 에 `headerOverlay: true`.
#}
<header class="site-header{% if headerOverlay %} site-header--overlay{% endif %}" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="{{ site.name }} 홈으로">
      <img class="brand__logo brand__logo--dark" src="/images/logo/logo.svg" alt="{{ site.name }}" width="180" height="34">
      <img class="brand__logo brand__logo--light" src="/images/logo/logo_wt.svg" alt="" aria-hidden="true" width="180" height="34">
      <span class="brand__fallback">{{ site.nameShort }}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="주 메뉴" data-nav-panel>
      <ul class="site-nav__list">
        {%- for item in nav.primary %}
        <li class="site-nav__item">
          <a class="site-nav__link" href="{{ item.url }}"
             {% if page.url | isCurrent(item.url) %}aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- if nav.children[item.key] and nav.children[item.key].length > 1 %}
          <ul class="site-nav__sub">
            {%- for child in nav.children[item.key] %}
            <li><a href="{{ child.url }}">{{ child.label }}</a></li>
            {%- endfor %}
          </ul>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>

      <div class="site-nav__contact">
        <a href="{{ site.contact.tel | telHref }}">{{ site.contact.tel }}</a>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </div>
    </nav>

    <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-nav-toggle>
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="sr-only">메뉴 열기</span>
    </button>
  </div>
  <div class="nav-backdrop" data-nav-backdrop hidden></div>
</header>
