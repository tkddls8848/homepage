{# 페이지 하단 공통 문의 유도 영역 (front matter 에 `cta: false` 로 숨김) #}
{%- if cta != false -%}
<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2 class="cta__title">도입을 검토하고 계신가요?</h2>
      <p class="cta__text">구성·견적·유지보수 문의를 남겨주시면 담당자가 확인 후 연락드립니다.</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href="/contact/inquiry/">문의하기</a>
      <a class="btn btn--ghost" href="{{ site.contact.tel | telHref }}">{{ site.contact.tel }}</a>
    </div>
  </div>
</section>
{%- endif -%}
