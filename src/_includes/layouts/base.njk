{%- set pageTitle = title if title else site.name -%}
{%- set metaTitle = (title + " | " + site.nameShort) if title else (site.name + " — " + site.tagline) -%}
{%- set metaDescription = description if description else site.description -%}
{%- set canonical = page.url | absoluteSiteUrl(site.url) -%}
<!doctype html>
<html lang="{{ site.lang }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta name="theme-color" content="#ed2024">
  <meta name="format-detection" content="telephone=no">

  {#-
    보안 헤더(CSP, HSTS, X-Frame-Options, Referrer-Policy 등)는 여기가 아니라
    `_headers` 파일에서 진짜 HTTP 응답 헤더로 나갑니다 → src/headers.11ty.js

    예전에는 GitHub Pages 가 헤더를 설정할 수 없어 CSP 를 meta 로 넣었는데,
    그 방식으로는 frame-ancestors 와 HSTS 가 무시됐습니다. Cloudflare Pages 로
    옮기면서 헤더로 일원화했습니다. 정책을 두 곳에 두면 어긋나므로 meta 판은
    남겨 두지 않습니다.
  -#}

  {#- 소셜 미리보기 -#}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  {#- SNS 미리보기는 SVG 를 지원하지 않는 곳이 많아 PNG 를 씁니다. -#}
  <meta property="og:image" content="{{ '/images/og/og-brand-v2.png' | absoluteSiteUrl(site.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/assets/img/favicon.svg' | url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>

  {%- if robots %}<meta name="robots" content="{{ robots }}">{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ '/' | absoluteSiteUrl(site.url) }}",
    "description": "{{ site.description }}",
    "telephone": "{{ site.contact.tel }}",
    "faxNumber": "{{ site.contact.fax }}",
    "email": "{{ site.contact.email }}",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "KR",
      "addressRegion": "서울특별시",
      "postalCode": "{{ site.contact.zip }}",
      "streetAddress": "{{ site.contact.address1 }} {{ site.contact.address2 }}"
    }
  }
  </script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a class="skip-link" href="#main">본문으로 바로가기</a>

  {% include "partials/site-header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/site-footer.njk" %}
</body>
</html>
