{%- set pageTitle = title if title else site.name -%}
{%- set metaTitle = (title + " | " + site.nameShort) if title else (site.name + " — " + site.tagline) -%}
{%- set metaDescription = description if description else site.description -%}
{%- set canonical = page.url | absoluteSiteUrl(site.url) -%}
<!doctype html>
<html lang="{{ site.lang }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta name="theme-color" content="#0b3f7d">
  <meta name="format-detection" content="telephone=no">

  {#-
    http 로 접속했을 때도 하위 자원은 https 로 요청하게 합니다.
    (GitHub Pages 의 *.github.io 는 http → https 로 자동 리다이렉트되지만,
     커스텀 도메인이나 다른 호스팅에서 혼합 콘텐츠가 생기는 것을 막아 줍니다.)
  -#}
  <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">

  {#- 소셜 미리보기 -#}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  {#- SNS 미리보기는 SVG 를 지원하지 않는 곳이 많아 PNG 를 씁니다. -#}
  <meta property="og:image" content="{{ '/images/og/og-default.png' | absoluteSiteUrl(site.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/assets/img/favicon.svg' | url }}">

  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>

  {%- if robots %}<meta name="robots" content="{{ robots }}">{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ '/' | absoluteSiteUrl(site.url) }}",
    "description": "{{ site.description }}",
    "telephone": "{{ site.contact.tel }}",
    "faxNumber": "{{ site.contact.fax }}",
    "email": "{{ site.contact.email }}",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "KR",
      "addressRegion": "서울특별시",
      "postalCode": "{{ site.contact.zip }}",
      "streetAddress": "{{ site.contact.address1 }} {{ site.contact.address2 }}"
    }
  }
  </script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a class="skip-link" href="#main">본문으로 바로가기</a>

  {% include "partials/site-header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/site-footer.njk" %}
</body>
</html>
