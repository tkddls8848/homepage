{%- set pageTitle = title if title else site.name -%}
{%- set metaTitle = (title + " | " + site.nameShort) if title else (site.name + " — " + site.tagline) -%}
{%- set metaDescription = description if description else site.description -%}
{%- set canonical = page.url | absoluteSiteUrl(site.url) -%}
<!doctype html>
<html lang="{{ site.lang }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta name="theme-color" content="#ed2024">
  <meta name="format-detection" content="telephone=no">

  {#-
    보안 헤더(CSP, HSTS, X-Frame-Options, Referrer-Policy 등)는 여기가 아니라
    `_headers` 파일에서 진짜 HTTP 응답 헤더로 나갑니다 → src/headers.11ty.js

    예전에는 GitHub Pages 가 헤더를 설정할 수 없어 CSP 를 meta 로 넣었는데,
    그 방식으로는 frame-ancestors 와 HSTS 가 무시됐습니다. Cloudflare Pages 로
    옮기면서 헤더로 일원화했습니다. 정책을 두 곳에 두면 어긋나므로 meta 판은
    남겨 두지 않습니다.
  -#}

  {#- 소셜 미리보기 -#}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  {#- SNS 미리보기는 SVG 를 지원하지 않는 곳이 많아 PNG 를 씁니다. -#}
  <meta property="og:image" content="{{ '/images/og/og-brand-v2.png' | absoluteSiteUrl(site.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">

  {#-
    아이콘. SVG 를 먼저 두고, 못 읽는 환경을 위해 PNG 를 뒤에 둡니다.
    apple-touch-icon 은 반드시 PNG 여야 합니다 — iOS 는 여기에 SVG 를 쓰면
    아이콘을 무시하고 페이지 스크린샷을 대신 씁니다.
    PNG 는 tools/make-icons.mjs 가 만듭니다(의존성 없이 직접 래스터화).
  -#}
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/img/favicon-32.png' | url }}" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>

  {#-
    카카오 "지도 퍼가기" 로더. front matter 에 kakaoMap: true 를 준 페이지에서만
    불러옵니다 — 외부 스크립트를 실행하게 되므로 필요한 곳에만 둡니다.

    async/defer 를 붙이면 안 됩니다. 이 로더는 document.write 로 실제 지도
    스크립트를 끼워 넣는데, 파싱이 끝난 뒤에 실행되면 문서를 통째로 덮어씁니다.
  -#}
  {%- if kakaoMap %}
  <script charset="UTF-8" class="daum_roughmap_loader_script"
          src="https://ssl.daumcdn.net/dmaps/map_js_init/roughmapLoader.js"></script>
  {%- endif %}

  {%- if robots %}<meta name="robots" content="{{ robots }}">{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ '/' | absoluteSiteUrl(site.url) }}",
    "description": "{{ site.description }}",
    "telephone": "{{ site.contact.tel }}",
    "faxNumber": "{{ site.contact.fax }}",
    "email": "{{ site.contact.email }}",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "KR",
      "addressRegion": "서울특별시",
      "postalCode": "{{ site.contact.zip }}",
      "streetAddress": "{{ site.contact.address1 }} {{ site.contact.address2 }}"
    }
  }
  </script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a class="skip-link" href="#main">본문으로 바로가기</a>

  {% include "partials/site-header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/site-footer.njk" %}

  {#- 지도를 그리는 호출. 로더가 먼저 실행돼 있어야 하므로 문서 끝에 둡니다. -#}
  {%- if kakaoMap %}
  <script src="{{ '/assets/js/kakao-map.js' | url }}"></script>
  {%- endif %}
</body>
</html>
