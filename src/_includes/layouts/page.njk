---
layout: layouts/base.njk
---

{%- set sectionMeta = nav.byKey[section] -%}

<div class="page-head">
  <div class="container">
    {%- if sectionMeta %}
    <nav class="breadcrumb" aria-label="현재 위치">
      <ol>
        <li><a href="{{ '/' | url }}">Home</a></li>
        <li><a href="{{ sectionMeta.url | url }}">{{ sectionMeta.label }}</a></li>
        <li><span aria-current="page">{{ title }}</span></li>
      </ol>
    </nav>
    {%- endif %}

  </div>
</div>

{% include "partials/subnav.njk" %}

<div class="page-content container">
  <header class="page-content__title">
    <p class="page-head__eyebrow">{{ eyebrow if eyebrow else (sectionMeta.label if sectionMeta else site.nameShort) }}</p>
    <h1 class="page-head__title">{{ title }}</h1>
  </header>
  <div class="page-content__main">
    {%- if lead %}
    <p class="page-head__lead">{{ lead }}</p>
    {%- endif %}
    <div class="page-body">
      {{ content | safe }}
    </div>
  </div>
</div>

{% include "partials/cta.njk" %}
