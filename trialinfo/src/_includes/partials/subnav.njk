
{%- if section == "product" and p -%}
<div class="subnav" data-level="2">
  <nav class="subnav__row subnav__row--primary" aria-label="제조사">
    <ul class="subnav__list container">
      {%- for vendor in nav.vendors %}
      <li>
        <a href="{{ vendor.url }}" {% if vendor.slug == p.vendorSlug %}aria-current="true"{% endif %}>{{ vendor.label }}</a>
      </li>
      {%- endfor %}
    </ul>
  </nav>

  {%- set currentVendor = nav.vendorsBySlug[p.vendorSlug] -%}
  {%- if currentVendor.categories.length > 1 %}
  <nav class="subnav__row subnav__row--secondary" aria-label="제품 분류">
    <ul class="subnav__list container">
      {%- for cat in currentVendor.categories %}
      <li>
        <a href="{{ cat.url }}" {% if cat.slug == p.categorySlug %}aria-current="page"{% endif %}>{{ cat.label }}</a>
      </li>
      {%- endfor %}
    </ul>
  </nav>
  {%- endif %}
</div>
{%- elif section and nav.children[section] and nav.children[section].length > 1 -%}
<div class="subnav" data-level="1">
  <nav class="subnav__row subnav__row--primary" aria-label="{{ section }} 하위 메뉴">
    <ul class="subnav__list container">
      {%- for child in nav.children[section] %}
      <li>
        <a href="{{ child.url }}" {% if page.url == child.url %}aria-current="page"{% endif %}>{{ child.label }}</a>
      </li>
      {%- endfor %}
    </ul>
  </nav>
</div>
{%- endif -%}
